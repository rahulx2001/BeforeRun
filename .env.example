# Local prototype settings. Reviews stay disabled until the live proof and release gates pass.
# The app never calls Cerebras directly; these values configure the dedicated OpenClaw Gateway route.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Trial ID supplied in the newer organizer FAQ; approved account access still needs testing.
CEREBRAS_MODEL=moonshotai-kimi-k3.1-pro-trial

# Server-owned OpenClaw integration. Used only when reviews are explicitly enabled.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_AGENT=beforerun-reviewer
# Optional: require the Gateway response model to match this value.
# Leave blank to require the route alias openclaw/<OPENCLAW_AGENT>.
OPENCLAW_EXPECTED_MODEL=
OPENCLAW_GATEWAY_TOKEN=

# Approved fallback uses OpenClaw's native provider failover; browser never calls Baseten.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Blank disables disclosure of a configured fallback. Set only after private Gateway setup.
OPENCLAW_FALLBACK_MODEL=
